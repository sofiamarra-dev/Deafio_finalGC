# Copie este arquivo para ".env" (sem o .example) e preencha. O ".env" nunca vai para o git.

# Chave da API da IA. Sem ela, o botão "Dica da IA" mostra a dica fixa de cada desafio.
ANTHROPIC_API_KEY=

# Modelo usado nas dicas. Um modelo pequeno e rápido basta.
MODELO_IA=claude-sonnet-5-5

# Para testar sem gastar nada: responde dicas prontas, sem chamar a IA (1 = ligado).
IA_FALSA=0

# Quem pode chamar a API pelo navegador (só precisa se o jogo for aberto por outro endereço, como o Live Server).
ORIGENS_PERMITIDAS=http://127.0.0.1:5500,http://localhost:5500

# Limite por aluno (por endereço IP): pedidos por minuto e por dia.
LIMITE_POR_MINUTO=4
LIMITE_POR_DIA=60
