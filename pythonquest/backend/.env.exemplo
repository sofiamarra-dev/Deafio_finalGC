# Copie este arquivo para .env e ajuste. O .env nunca vai para o Git.

# desenvolvimento ou producao. Em producao o corretor sem Docker se recusa a rodar.
AMBIENTE=desenvolvimento

# Banco de dados. SQLite no desenvolvimento; em produção, PostgreSQL:
# URL_BANCO=postgresql+psycopg://usuario:senha@localhost:5432/pythonquest
URL_BANCO=sqlite:///./pythonquest.db
