# Copie este arquivo para .env e ajuste. O .env nunca vai para o Git.

# desenvolvimento ou producao. Em producao o corretor sem Docker se recusa a rodar.
AMBIENTE=desenvolvimento

# Banco de dados. SQLite no desenvolvimento; em produção, PostgreSQL:
# URL_BANCO=postgresql+psycopg://usuario:senha@localhost:5432/pythonquest
URL_BANCO=sqlite:///./pythonquest.db

# Código para professores criarem conta pelo site (opção "Sou professor" no cadastro).
# Passe só para os professores. Use algo difícil de adivinhar; deixe vazio para desligar.
CODIGO_PROFESSOR=troque-por-um-codigo-secreto

# Corretor dos exercícios: docker (seguro; precisa do Docker Desktop aberto) ou local (só para desenvolver sem Docker).
CORRETOR=docker
SANDBOX_IMAGEM=python:3.12-alpine
